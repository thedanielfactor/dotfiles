function batdiff() {
    git diff --name-only --diff-filter=d | xargs bat --diff
}

# Encrypt File
function encFile() {
  if (( $# < 1 )); then
    echo "Usage: $funcstack[1] <filename> [output filename]"
    return 1
  fi

  local inFile=$1 outFile=$1.enc

  if (( $# > 1 )); then
    outFile=$2
  fi

  openssl aes-256-cbc -a -salt -pbkdf2 -in $inFile -out $outFile 
  trash $inFile
}

